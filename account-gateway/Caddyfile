{$LATTICE_ACCOUNT_ORIGIN} {
	route {
		header {
			Cache-Control "private, no-store"
			Referrer-Policy "same-origin"
		}

		@sign_out path /oauth2/sign_out
		header @sign_out +Set-Cookie "lattice_session=; Path=/api; Max-Age=0; Secure; HttpOnly; SameSite=Strict"
		reverse_proxy /oauth2/* 127.0.0.1:{$LATTICE_OAUTH_PORT:4180} {
			header_up -Authorization
			header_up -X-Lattice-Account-Proxy
		}

		# Only the documented OAuth2 Proxy allow decision permits forwarding.
		reverse_proxy 127.0.0.1:{$LATTICE_OAUTH_PORT:4180} {
			method GET
			rewrite /oauth2/auth
			header_up -Authorization
			header_up -X-Lattice-Account-Proxy
			@allowed status 202
			handle_response @allowed {
				request_header -X-Lattice-Account-Proxy
			}
			@sign_in status 401
			handle_response @sign_in {
				@document {
					method GET
					header Accept *text/html*
					not path /api /api/*
				}
				redir @document /oauth2/start?rd=/ 302
				respond "Sign in to Remote Workspace." 401
			}
		}

		@bootstrap {
			method GET
			path /api/session
		}
		reverse_proxy @bootstrap 127.0.0.1:{$LATTICE_BACKEND_PORT:18492} {
			header_up -Authorization
			header_up X-Lattice-Account-Proxy "{env.LATTICE_BACKEND_TOKEN}"
		}
		reverse_proxy 127.0.0.1:{$LATTICE_BACKEND_PORT:18492} {
			header_up -Authorization
			header_up -X-Lattice-Account-Proxy
		}
	}
}
